draw_set_color(c_white);
draw_set_halign(fa_center);
draw_set_valign(fa_middle);

var cx = display_get_gui_width() / 2;
var cy = display_get_gui_height() / 2;

draw_text(cx, cy - 100, "Story:");

draw_text(cx, cy - 20, "you have undertaken experiments and are now a small fish");
draw_text(cx, cy + 10, "You have to go deeper and deeper to recover your original form");
draw_text(cx, cy + 40, "Through each level you will become bigger");
draw_text(cx, cy + 70, " And for some weird reasons, you shoot fire ball and swimm reversly");
draw_text(cx, cy + 90, "You start in the high tech lab. then you go beneath the earth and at the end you go in the deep sea to kill the boss");
draw_text(cx, cy + 120, "");

draw_text(cx, cy + 170, "Press ENTER to Start");